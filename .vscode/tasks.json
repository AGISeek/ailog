{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "extension: compile",
			"type": "shell",
			"command": "pnpm",
			"args": ["--filter", "@ailog/extension", "build"],
			"group": {
				"kind": "build",
				"isDefault": true
			},
			"presentation": {
				"echo": true,
				"reveal": "silent",
				"focus": false,
				"panel": "shared",
				"showReuseMessage": true,
				"clear": false
			},
			"problemMatcher": "$tsc",
			"options": {
				"cwd": "${workspaceFolder}"
			}
		},
		{
			"label": "extension: watch",
			"type": "shell",
			"command": "pnpm",
			"args": ["--filter", "@ailog/extension", "dev"],
			"group": "build",
			"presentation": {
				"echo": true,
				"reveal": "always",
				"focus": false,
				"panel": "dedicated",
				"showReuseMessage": false,
				"clear": false
			},
			"isBackground": true,
			"problemMatcher": {
				"base": "$tsc-watch",
				"fileLocation": ["relative", "${workspaceFolder}/packages/extension"]
			},
			"options": {
				"cwd": "${workspaceFolder}"
			}
		},
		{
			"label": "dashboard: build",
			"type": "shell",
			"command": "pnpm",
			"args": ["--filter", "@ailog/dashboard", "build"],
			"group": "build",
			"presentation": {
				"echo": true,
				"reveal": "silent",
				"focus": false,
				"panel": "shared",
				"showReuseMessage": true,
				"clear": false
			},
			"problemMatcher": "$tsc",
			"options": {
				"cwd": "${workspaceFolder}"
			}
		},
		{
			"label": "shared: build",
			"type": "shell", 
			"command": "pnpm",
			"args": ["--filter", "@ailog/shared", "build"],
			"group": "build",
			"presentation": {
				"echo": true,
				"reveal": "silent",
				"focus": false,
				"panel": "shared",
				"showReuseMessage": true,
				"clear": false
			},
			"problemMatcher": "$tsc",
			"options": {
				"cwd": "${workspaceFolder}"
			}
		},
		{
			"label": "build-all",
			"dependsOrder": "sequence",
			"dependsOn": [
				"shared: build",
				"extension: compile",
				"dashboard: build"
			],
			"group": "build",
			"presentation": {
				"echo": true,
				"reveal": "always",
				"focus": false,
				"panel": "shared",
				"showReuseMessage": true,
				"clear": false
			}
		}
	]
}