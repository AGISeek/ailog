{
	"name": "ailog-workspace",
	"private": true,
	"description": "AIlog VS Code Extension Workspace",
	"version": "1.0.0",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "https://github.com/AGISeek/ailog"
	},
	"packageManager": "pnpm@9.0.0",
	"workspaces": [
		"packages/*",
		"shared"
	],
	"scripts": {
		"build": "pnpm -r build",
		"dev": "pnpm -r --parallel dev",
		"lint": "pnpm -r lint",
		"clean": "pnpm -r clean",
		"extension:build": "pnpm --filter=@ailog/extension build",
		"extension:package": "pnpm --filter=@ailog/extension package",
		"dashboard:build": "pnpm --filter=@ailog/dashboard build",
		"dashboard:dev": "pnpm --filter=@ailog/dashboard dev",
		"vscode:prepublish": "pnpm build"
	},
	"devDependencies": {
		"@types/node": "^18.19.0",
		"typescript": "^5.3.3",
		"eslint": "^8.56.0",
		"@typescript-eslint/eslint-plugin": "^6.15.0",
		"@typescript-eslint/parser": "^6.15.0"
	}
}
